# Copie para .env (nesta pasta) e preencha. O .env NUNCA vai para o GitHub.

# Domínio que aponta para este servidor (sem https://)
DOMINIO=painel.exemplo.com.br

# Chave que cifra os segredos da verificação em duas etapas e os backups.
# Gere com:  docker compose run --rm app python -m meterwatt --gerar-chave
# Guarde uma cópia FORA do servidor: sem ela, os backups não abrem.
MW_CHAVE_CRIPTO=

# Administrador do servidor de mensagens (o aplicativo usa esta conta). Invente uma senha longa.
MQTT_USUARIO=meterwatt-servidor
MQTT_SENHA=

# Conta que os medidores usam ANTES de parear (vai na página de configuração de cada medidor).
# Ela só consegue pedir pareamento: não lê nem envia consumo.
MW_MQTT_PROVISAO_USUARIO=pareamento
MW_MQTT_PROVISAO_SENHA=

# E-mail (confirmação de conta, avisos). Qualquer provedor com SMTP e STARTTLS.
MW_EMAIL_MODO=smtp
MW_SMTP_HOST=
MW_SMTP_PORTA=587
MW_SMTP_USUARIO=
MW_SMTP_SENHA=
MW_REMETENTE=MeterWatt <nao-responda@exemplo.com.br>

# Aparecem na política de privacidade
MW_CONTROLADOR=
MW_EMAIL_PRIVACIDADE=
MW_ENCARREGADO=
# Quem recebe avisos de falha de segurança (vai em /.well-known/security.txt). Em branco, usa o de privacidade.
MW_EMAIL_SEGURANCA=

# Notificações no celular e no computador (avisos com o app fechado). Sem esta chave, ficam desligadas.
# Gere com:  docker compose run --rm app python -m meterwatt --gerar-vapid
# Guarde junto da MW_CHAVE_CRIPTO: trocar a chave desliga as notificações de todos os aparelhos.
MW_VAPID_CHAVE_PRIVADA=
# Contato que vai junto de cada envio, para os serviços de notificação (Google, Apple...) falarem com vocês
# (mailto:... ou https://...). Em branco, usa o MW_EMAIL_PRIVACIDADE ou o endereço do site.
MW_VAPID_CONTATO=

# App na Play Store (opcional, veja docs/app-celular.md). O pacote e a impressão SHA-256 da chave
# que assina o app (a da Play, em "Integridade do app"). Mais de uma impressão: separe por vírgula.
#MW_ANDROID_PACOTE=br.com.meterwatt.app
#MW_ANDROID_SHA256=AA:BB:...

# Opcionais
# Recusa senhas que já vazaram (Pwned Passwords; só 5 caracteres do resumo saem). Ligado em produção.
#MW_SENHAS_VAZADAS=1
MW_TARIFA_PADRAO=
MW_EXIGIR_2FA=0
MW_BACKUP_MANTER=14

# Cobrança: desligado até vocês decidirem. Para testar com o Mercado Pago (credenciais de TESTE):
#MW_PAGAMENTO_PROVEDOR=mercadopago
#MW_MP_ACCESS_TOKEN=TEST-...
#MW_MP_WEBHOOK_SEGREDO=
#MW_PLANO_PRECO=14.90
