# Copie para .env (nunca versione o .env) e carregue antes de iniciar:
#   set -a; . ./.env; set +a; python -m meterwatt
MW_MODO=producao
MW_URL_PUBLICA=https://painel.exemplo.com.br
# Gere com: python -m meterwatt --gerar-chave   (guarde num cofre: sem ela, a verificação em duas etapas para de funcionar)
MW_CHAVE_CRIPTO=
MW_PASTA_INSTANCIA=/var/lib/meterwatt
MW_HTTP_HOST=127.0.0.1
MW_HTTP_PORTA=8000
# Atrás de Caddy ou nginx que preenche X-Forwarded-For:
MW_CONFIAR_PROXY=1
MW_TARIFA_PADRAO=
MW_EXIGIR_2FA=0

MW_EMAIL_MODO=smtp
MW_SMTP_HOST=
MW_SMTP_PORTA=587
MW_SMTP_USUARIO=
MW_SMTP_SENHA=
MW_REMETENTE=MeterWatt <nao-responda@exemplo.com.br>

# Aparecem na política de privacidade
MW_CONTROLADOR=
MW_EMAIL_PRIVACIDADE=
MW_ENCARREGADO=

MQTT_HOST=localhost
MQTT_PORTA=8883
MQTT_TLS=1
MQTT_USUARIO=meterwatt-servidor
MQTT_SENHA=
